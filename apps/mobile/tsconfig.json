{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["expo/tsconfig.base", "magic-tsconfig/expo.json"],
  "compilerOptions": {
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../nextjs/src/app/global-error.tsx"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "metro.config.js",
    "babel.config.js"
  ]
}
