/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
pnpm-debug.log*
pnpm-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.next-*/
.env*
