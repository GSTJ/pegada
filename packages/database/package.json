{
  "name": "@pegada/database",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "license": "AGPL-3.0-or-later",
  "author": "",
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./*": [
      "./*.ts",
      "./*/index.ts"
    ]
  },
  "scripts": {
    "studio": "prisma studio",
    "build": "npx prisma generate",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "db:up": "docker-compose up --build --detach",
    "db:seed": "npx prisma db seed",
    "maestro:seed": "tsx ./maestro-seed.ts seed",
    "maestro:purge": "tsx ./maestro-seed.ts purge",
    "maestro:check-deleted": "tsx ./maestro-seed.ts check",
    "db:setup": "pnpm db:up && pnpm migrate deploy && pnpm db:seed",
    "db:push": "npx prisma db push",
    "prisma": "npx prisma",
    "test:db:up": "if [ -n \"$CI\" ]; then echo 'CI supplies Postgres as a workflow service container, skipping docker-compose'; else docker-compose -f docker-compose.test.yml up --build --detach; fi",
    "test:db:setup": "pnpm test:db:up && pnpm migrate deploy",
    "migrate": "npx prisma migrate",
    "postinstall": "pnpm run build"
  },
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^5.17.0",
    "magic-tsconfig": "^1.1.0",
    "prisma": "^5.17.0",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "@prisma/client": "*"
  },
  "prisma": {
    "seed": "tsx ./seed.ts"
  }
}
