{
  "name": "pegada",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "mobile": "dotenv -e .env.dev -- pnpm -F @pegada/mobile",
    "nextjs": "dotenv -e .env.dev -- pnpm -F @pegada/nextjs",
    "start:everything": "npx concurrently --kill-others-on-fail \"pnpm nextjs dev\" \"pnpm mobile start\"",
    "api": "dotenv -e .env.dev -- pnpm -F @pegada/api",
    "database": "dotenv -e .env.dev -- pnpm -F @pegada/database",
    "database:test": "dotenv -e .env.test -- pnpm -F @pegada/database",
    "test": "dotenv -e .env.test -- turbo test",
    "build": "dotenv -e .env.dev -- turbo build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "i18n:parse": "npx i18next-parser",
    "typecheck": "turbo typecheck",
    "changelog": "python3 .github/scripts/changelog.py --all --repo GSTJ/pegada --output CHANGELOG.md",
    "convert:images": "./scripts/convert-png-images-to-webp.sh",
    "download:secrets": "dotenv -- ./scripts/download-secrets.sh"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "magic-codemods": "^1.0.0",
    "magic-oxfmt-config": "^1.0.0",
    "magic-oxlint-config": "^1.0.0",
    "magic-tsconfig": "^1.0.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "turbo": "^2.9.12",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@11.17.0"
}
